# ============================================================
# 环境变量模板：复制为 .env 后按需修改，切勿提交真实凭据
# ============================================================

# ---- Neo4j 连接（可选） ----
# 使用 script/neo4j_knowledge_storage.py / neo4j_hypergraph_generator.py 前配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---- OpenKE 外部训练（可选） ----
# 本地克隆 OpenKE 源码后，可用该变量指定路径（默认 data/OpenKE）
# OPENKE_ROOT=/path/to/OpenKE
